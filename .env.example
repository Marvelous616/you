# Life Logger server runtime settings.
# Copy to .env for local development, or set the same names in
# /etc/lifelogger.env on the server. Values below are development defaults.

# Database file. Relative paths resolve against the process working directory.
DB_PATH=data/life-logger.sqlite

# Built web app served by the API process. Relative to the working directory.
WEB_DIR=apps/web/dist

# Bind address and port.
HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional shared secret. When set, every /api/ request must send
# "Authorization: Bearer <API_KEY>". /health and the static web app stay open.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Release identifier shown by /health and in the web footer.
# Deploys set this from the git tag; leave empty to read the root package.json.
APP_VERSION=
