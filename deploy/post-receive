#!/usr/bin/env bash
#
# Git hook for the bare repository on the server.
#
# A pushed v* tag is deployed. Branch pushes and tag deletions are ignored.
# Install to $APP_ROOT/repo.git/hooks/post-receive with mode 0755.
set -euo pipefail

unset GIT_DIR GIT_WORK_TREE

DEPLOY_SCRIPT="${DEPLOY_SCRIPT:-/opt/lifelogger/deploy.sh}"
ZERO="0000000000000000000000000000000000000000"

while read -r _old new ref; do
  case "$ref" in
    refs/tags/v*)
      if [ "$new" = "$ZERO" ]; then
        echo "Tag deleted: ${ref#refs/tags/} (not deploying)"
        continue
      fi
      tag="${ref#refs/tags/}"
      echo "Tag pushed: $tag"
      "$DEPLOY_SCRIPT" "$tag"
      ;;
  esac
done
