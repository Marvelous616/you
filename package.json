{
  "name": "life-logger",
  "version": "0.3.6",
  "private": true,
  "description": "Life Logger - personal offline-first timeline and life event tracker",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "npm run --workspaces --if-present lint",
    "package": "bash packaging/build.sh",
    "release": "bash packaging/release.sh",
    "test:package": "node scripts/run-bash.mjs packaging/test/run.sh",
    "shellcheck": "shellcheck packaging/*.sh packaging/test/*.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
