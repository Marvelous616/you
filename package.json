{
  "name": "life-logger",
  "version": "0.3.5",
  "private": true,
  "description": "Life Logger - personal offline-first timeline and life event tracker",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "npm run --workspaces --if-present lint",
    "test:deploy": "node scripts/run-bash.mjs deploy/test/deploy.test.sh",
    "shellcheck": "shellcheck deploy/*.sh deploy/post-receive deploy/test/*.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
