# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
.expo-env.d.ts

# Android and Expo native build output (created by `expo prebuild`)
apps/android/android/
apps/android/ios/
.gradle/
local.properties
*.apk
*.aab
*.ipa

# Signing material must never be committed
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision

# SQLite databases & temp files
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
data/
backups/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/
coverage/

# Environment files
.env
.env.local
.env.*.local
.env.*
!.env.example

# Pacman package build output
packaging/src/
packaging/pkg/
packaging/*.pkg.tar.zst
packaging/*.pkg.tar.zst.sha256
# makepkg keeps a bare git source clone here (SRCDEST defaults to the PKGBUILD dir)
packaging/lifelogger-*/

# OS files
.DS_Store
Thumbs.db
