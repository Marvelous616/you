# Life Logger server configuration.
# Installed as /etc/lifelogger.env with backup= in the package, so pacman
# upgrades keep this file. All values are placeholders: fill in API_KEY before
# the service can accept API requests.

# Database. The package creates this directory with systemd-tmpfiles.
DB_PATH=/var/lib/lifelogger/life-logger.sqlite

# Static web app shipped in the same package.
WEB_DIR=/usr/lib/lifelogger/web

# Bind to loopback; HTTPS is provided by "tailscale serve --bg 8080".
# Change to 0.0.0.0 only if you intentionally expose plain HTTP on the LAN.
HOST=127.0.0.1
PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Shared secret for /api/. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every /api/ request must then send "Authorization: Bearer <API_KEY>".
# /health and the static web app stay public.
API_KEY=

# APP_VERSION is deliberately absent. /usr/bin/lifelogger sets it from
# /usr/lib/lifelogger/version so /health always reports the installed package.
