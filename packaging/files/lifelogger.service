[Unit]
Description=Life Logger server
Documentation=https://github.com/Marvelous616/you
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifelogger
Group=lifelogger
WorkingDirectory=/usr/lib/lifelogger
EnvironmentFile=/etc/lifelogger.env
ExecStart=/usr/bin/lifelogger
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lifelogger
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifelogger

[Install]
WantedBy=multi-user.target
