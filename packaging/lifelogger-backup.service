[Unit]
Description=Life Logger database backup
Documentation=https://github.com/Marvelous616/you
After=network.target

[Service]
Type=oneshot
User=lifelogger
Group=lifelogger
EnvironmentFile=/usr/lib/lifelogger/lifelogger.env
EnvironmentFile=-/etc/lifelogger.env
ExecStart=/usr/lib/lifelogger/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lifelogger
